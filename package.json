{
  "name": "photoeditor",
  "version": "3.7.0",
  "description": "Модульный фоторедактор на vanilla JS (ES Modules) без runtime-зависимостей",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "css": "sass scss/layout.scss layout.css",
    "css:watch": "sass --watch scss/layout.scss:layout.css",
    "css:check": "node scripts/css-check.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.30.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "sass": "^1.89.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
